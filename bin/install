set -eo pipefail

# Prints the directory under which PHP is built for an install path that holds a
# space. It is the first of these without a space: the XDG data directory, the
# data directory under $HOME, or /var/tmp for this user.
build_base() {
  local candidate
  for candidate in \
    "${XDG_DATA_HOME:+$XDG_DATA_HOME/vfox-php}" \
    "${HOME:+$HOME/.local/share/vfox-php}" \
    "/var/tmp/vfox-php-$(id -u)"; do
    if [ -n "$candidate" ] && [[ ! "$candidate" =~ [[:space:]] ]]; then
      echo "$candidate"
      return 0
    fi
  done
  echo "ERROR: no directory without spaces to build PHP in" >&2
  return 1
}

# Prints the build directory of an install path with a space. Its name is a
# checksum of the install path, so two VFOX_HOMEs never share one.
build_dir_for() {
  local install_path=$1 base
  base=$(build_base) || return 1
  echo "$base/builds/$(printf '%s' "$install_path" | cksum | cut -d' ' -f1)"
}

# Removes what install_php leaves behind when it fails: the link at the install
# path, the build directory and the source directory.
discard_build() {
  local install_path=$1 build_dir=$2 source_path=$3
  if [ -L "$install_path" ]; then
    rm -f "$install_path"
  fi
  rm -rf "$build_dir" "$source_path"
}

# Removes the build directory that an install path with a space links to. vfox
# removes the link itself; this only removes what the link points to.
remove_build() {
  local install_path=$1 target
  if [ ! -L "$install_path" ]; then
    return 0
  fi
  target=$(readlink "$install_path")
  case "$target" in
    */vfox-php*/builds/[0-9]*)
      rm -rf "$target"
      ;;
    *)
      echo "ERROR: $install_path links to $target, which is not a vfox-php build directory" >&2
      return 1
      ;;
  esac
}

install_php() {
  local install_path=$1
  local prefix=$install_path
  local source_path="${install_path}_source"
  local build_dir=""
  local operating_system=$(uname -a)

  # A missing build dependency ends the install here, before the source is moved
  # or compiled, rather than after a long build. macOS checks Homebrew instead.
  if [[ ! $operating_system =~ "Darwin" ]]; then
    check_linux_build_dependencies || return 1
  fi

  # PHP's make install does not quote its paths, and neither do the pear and pecl
  # scripts it writes, so PHP cannot be built or installed under a path with a
  # space. Such an install path becomes a link to a build directory without spaces.
  if [[ "$install_path" =~ [[:space:]] ]]; then
    build_dir=$(build_dir_for "$install_path") || return 1
    prefix=$build_dir
    source_path="$build_dir.source"
    rm -rf "$build_dir" "$source_path"
    mkdir -p "$(dirname "$build_dir")"
    trap "discard_build $(printf '%q ' "$install_path" "$build_dir" "$source_path")" EXIT
  fi

  local configured
  configured="$(construct_configure_options "$prefix")" || return 1
  # One argument per line, so that each argument stays whole.
  local -a configure_args=()
  local option
  while IFS= read -r option; do
    configure_args+=("$option")
  done <<<"$configured"

  if [[ $operating_system =~ "Darwin" ]]; then
    exit_if_homebrew_not_installed

    local bison_path=$(homebrew_package_path bison)
    local icu4c_path=$(homebrew_package_path icu4c)
    local krb5_path=$(homebrew_package_path krb5)
    local libedit_path=$(homebrew_package_path libedit)
    local libxml2_path=$(homebrew_package_path libxml2)
    local libxslt_path=$(homebrew_package_path libxslt)
    local openssl_path
    # Explicit configure options own their dependency paths, as before.
    if [ -z "${PHP_CONFIGURE_OPTIONS:-}" ]; then
      openssl_path=$(homebrew_openssl_path) || return 1
    fi

    if [ -n "$bison_path" ]; then
      export "PATH=${bison_path}/bin:${PATH}"
    fi

    if [ -n "$icu4c_path" ]; then
      export "PKG_CONFIG_PATH=${icu4c_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi

    if [ -n "$krb5_path" ]; then
      export "PKG_CONFIG_PATH=${krb5_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi

    if [ -n "$libedit_path" ]; then
      export "PKG_CONFIG_PATH=${libedit_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi

    if [ -n "$libxml2_path" ]; then
      export "PKG_CONFIG_PATH=${libxml2_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi

    if [ -n "$libxslt_path" ]; then
      export "PKG_CONFIG_PATH=${libxslt_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi

    if [ -n "$openssl_path" ]; then
      export "PKG_CONFIG_PATH=${openssl_path}/lib/pkgconfig:${PKG_CONFIG_PATH}"
    fi
  fi

  # Running this in a subshell because we don't to disturb the current
  # working directory.
  (
    mv "$install_path" "$source_path"
    if [ -n "$build_dir" ]; then
      ln -s "$build_dir" "$install_path"
    fi
    cd "$source_path"

    # Target is OS-specific
    # target=$(get_target)

    # Build PHP
    echo "Running buildconfig..."
    ./buildconf --force || exit 1
    echo "Running ./configure ${configure_args[*]}"
    ./configure "${configure_args[@]}" || exit 1
    echo "Running make"
    make || exit 1
    echo "Running make install..."
    # make test || exit 1
    make install || exit 1
  )

  # it's not obvious where php.ini should be placed, let us make it easy for the user
  mkdir -p "$install_path/conf.d/"
  echo "# add system-wide php configuration options here" >"$install_path/conf.d/php.ini"
  rm -rf "$source_path"
}

install_composer() {
  local bin_path=$1/bin
  local expected_signature
  expected_signature="$(curl -sL https://composer.github.io/installer.sig)"

  # The installer is fetched into the bin directory, not into the directory the
  # install was started from. A signature that does not match stops the install.
  (
    cd "$bin_path" || exit 1
    ./php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" || exit 1
    ./php -r "if (hash_file('sha384', 'composer-setup.php') === '${expected_signature}') { echo 'Installer verified'; } else { echo 'Installer corrupt'; unlink('composer-setup.php'); exit(1); } echo PHP_EOL;" || exit 1
    ./php composer-setup.php --install-dir=. --filename=composer || exit 1
    ./php -r "unlink('composer-setup.php');"
  )
}

# Prints the configure arguments for PHP built into install_path, one per line.
construct_configure_options() {
  local install_path=$1
  local -a platform_args=()
  local -a extra_args=()

  # many options included below are not applicable to newer PHP versions
  # including these will trigger a build warning, but will not break the build
  local -a global_args=(
    "--prefix=$install_path"
    --enable-bcmath
    --enable-calendar
    --enable-dba
    --enable-exif
    --enable-fpm
    --enable-ftp
    --enable-gd
    --enable-gd-native-ttf
    --enable-intl
    --enable-mbregex
    --enable-mbstring
    --enable-mysqlnd
    --enable-pcntl
    --enable-shmop
    --enable-soap
    --enable-sockets
    --enable-sysvmsg
    --enable-sysvsem
    --enable-sysvshm
    --enable-wddx
    --enable-zip
    "--sysconfdir=$install_path"
    "--with-config-file-path=$install_path"
    "--with-config-file-scan-dir=$install_path/conf.d"
    --with-curl
    --with-external-gd
    --with-fpm-group=www-data
    --with-fpm-user=www-data
    --with-gd
    --with-mhash
    --with-mysql=mysqlnd
    --with-mysqli=mysqlnd
    --with-pdo-mysql=mysqlnd
    --with-xmlrpc
    --with-zip
    --with-zlib
    --without-snmp
  )

  if [ "$PHP_CONFIGURE_OPTIONS" = "" ]; then
    local platform_options
    platform_options=$(os_based_configure_options) || return 1
    read -r -a platform_args <<<"$platform_options" || true
  else
    read -r -a platform_args <<<"$PHP_CONFIGURE_OPTIONS" || true
  fi

  if [ "${PHP_WITHOUT_PEAR:-no}" != "no" ]; then
    extra_args+=(--without-pear)
  else
    extra_args+=(--with-pear)
  fi

  # PCRE JIT is on in PHP's own configuration, so it stays on unless
  # PHP_WITHOUT_PCRE_JIT asks for --without-pcre-jit.
  if [ "${PHP_WITHOUT_PCRE_JIT:-no}" != "no" ]; then
    extra_args+=(--without-pcre-jit)
  fi

  printf '%s\n' "${platform_args[@]}" "${global_args[@]}" "${extra_args[@]}"
}

homebrew_package_path() {
  local package_name=$1

  if [ "$(brew ls --versions $package_name)" = "" ]; then
    echo ""
  else
    echo "$(brew --prefix $package_name)"
  fi
}

homebrew_openssl_path() {
  # PHP 7.1-8.0 requires OpenSSL < 3.0; PHP 8.1+ supports OpenSSL 3.
  # See https://www.php.net/manual/en/openssl.requirements.php
  local major minor formula path
  if [[ ! "${PHP_VERSION:-}" =~ ^([0-9]+)\.([0-9]+)\. ]]; then
    echo "ERROR: Cannot determine PHP version for OpenSSL selection" >&2
    return 1
  fi
  major=${BASH_REMATCH[1]}
  minor=${BASH_REMATCH[2]}
  formula=openssl@1.1
  if (( major > 8 || (major == 8 && minor >= 1) )); then
    formula=openssl@3
  fi
  path=$(homebrew_package_path "$formula")
  if [ -z "$path" ]; then
    echo "ERROR: PHP $PHP_VERSION requires $formula; install a compatible dependency before building." >&2
    return 1
  fi
  echo "$path"
}

exit_if_homebrew_not_installed() {
  if [ "$(brew --version 2>/dev/null)" = "" ]; then
    echo "ERROR: Please install homebrew for OSX"
    exit 1
  fi
}

# Succeeds when the system has the shared library and the header that configure
# needs for it. The library is looked up in the dynamic linker's cache, which
# ldconfig lists, so no search database has to be built first.
have_system_library() {
  local library=$1 header=$2
  local cache
  cache="$(ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null || true)"
  grep -q -- "$library" <<<"$cache" && echo "#include <$header>" | cc -E -x c - >/dev/null 2>&1
}

# Prints the build dependencies of PHP on Linux, one per line as kind|name|need|package.
# A tool is run as "name --version". A pkg is one or more pkg-config modules, which
# configure looks up with PKG_CHECK_MODULES, so pkg-config must know them all. A
# header must be found by the compiler. need says what uses the dependency, and
# package is the Debian or Ubuntu package that provides it. The last four are used
# by the platform options, which PHP_CONFIGURE_OPTIONS replaces, as
# construct_configure_options does.
linux_build_requirements() {
  printf '%s\n' \
    'tool|cc|a C compiler|build-essential' \
    'tool|make|the build|build-essential' \
    'tool|autoconf|buildconf|autoconf' \
    'tool|pkg-config|the libraries that configure looks up with pkg-config|pkg-config' \
    'tool|curl|the Composer installer|curl' \
    'pkg|zlib|--with-zlib|zlib1g-dev' \
    'pkg|libxml-2.0|the xml, dom, simplexml and soap extensions|libxml2-dev' \
    'pkg|libcurl|--with-curl|libcurl4-openssl-dev' \
    'pkg|gdlib|--with-external-gd|libgd-dev' \
    'pkg|libpng|the PNG support of gd|libpng-dev' \
    'pkg|libzip|--with-zip|libzip-dev' \
    'pkg|icu-uc icu-io icu-i18n|--enable-intl|libicu-dev' \
    'pkg|oniguruma|--enable-mbregex|libonig-dev' \
    'pkg|sqlite3|the sqlite3 and pdo_sqlite extensions|libsqlite3-dev'
  if [ -z "${PHP_CONFIGURE_OPTIONS:-}" ]; then
    printf '%s\n' \
      'header|openssl/ssl.h|--with-openssl|libssl-dev' \
      'header|readline/readline.h|--with-readline|libreadline-dev' \
      'header|libintl.h|--with-gettext|libc6-dev' \
      'pkg|libxslt|--with-xsl|libxslt-dev'
  fi
}

# Succeeds when the compiler finds the header.
have_header() {
  echo "#include <$1>" | cc -E -x c - >/dev/null 2>&1
}

# Succeeds when the tool runs, which shows that it is installed.
have_tool() {
  "$1" --version >/dev/null 2>&1
}

# Succeeds when pkg-config knows every module named. The name is split on purpose,
# since a pkg may name several modules.
have_pkg() {
  pkg-config --exists $1 >/dev/null 2>&1
}

# Prints each Linux build dependency that is missing, with what needs it, and the
# packages that provide them. Returns 1 when one is missing.
check_linux_build_dependencies() {
  local kind name need package found
  local missing="" packages=""
  while IFS='|' read -r kind name need package; do
    found=1
    if [ "$kind" = tool ]; then
      have_tool "$name" || found=0
    elif [ "$kind" = pkg ]; then
      have_pkg "$name" || found=0
    else
      have_header "$name" || found=0
    fi
    if [ "$found" = 0 ]; then
      missing="${missing}  - ${name}: ${need}"$'\n'
      case " $packages " in
        *" $package "*) ;;
        *) packages="$packages $package" ;;
      esac
    fi
  done < <(linux_build_requirements)
  if [ -z "$missing" ]; then
    return 0
  fi
  {
    echo "ERROR: PHP cannot be built, because these build dependencies are missing. Nothing was compiled:"
    printf '%s' "$missing"
    echo "Install them and run vfox install again. The packages are named for Debian and Ubuntu:"
    echo "  sudo apt-get install --assume-yes$packages"
  } >&2
  return 1
}

os_based_configure_options() {
  local operating_system=$(uname -a)
  local configure_options=""

  if [[ $operating_system =~ "Darwin" ]]; then

    exit_if_homebrew_not_installed

    local bison_path=$(homebrew_package_path bison)
    local bzip2_path=$(homebrew_package_path bzip2)
    local freetype_path=$(homebrew_package_path freetype)
    local gettext_path=$(homebrew_package_path gettext)
    local iconv_path=$(homebrew_package_path libiconv)
    local icu4c_path=$(homebrew_package_path icu4c)
    local jpeg_path=$(homebrew_package_path jpeg)
    local libedit_path=$(homebrew_package_path libedit)
    local libpng_path=$(homebrew_package_path libpng)
    local libxml2_path=$(homebrew_package_path libxml2)
    local libxslt_path=$(homebrew_package_path libxslt)
    local libzip_path=$(homebrew_package_path libzip)
    local openssl_path
    openssl_path=$(homebrew_openssl_path) || return 1
    local readline_path=$(homebrew_package_path readline)
    local webp_path=$(homebrew_package_path webp)
    local zlib_path=$(homebrew_package_path zlib)

    # optional
    # if these packages exist they are included in the php compilation
    local gmp_path=$(homebrew_package_path gmp)
    local sodium_path=$(homebrew_package_path libsodium)

    if [ -n "$gmp_path" ]; then
      configure_options="--with-gmp=$gmp_path"
    else
      echo "gmp not found, not including in installation" >&2
    fi

    if [ -n "$sodium_path" ]; then
      configure_options="$configure_options --with-sodium=$sodium_path"
    else
      echo "sodium not found, not including in installation" >&2
    fi

    if [ -n "$freetype_path" ]; then
      configure_options="$configure_options --with-freetype-dir=$freetype_path"
    fi

    if [ -n "$gettext_path" ]; then
      configure_options="$configure_options --with-gettext=$gettext_path"
    fi

    if [ -n "$icu4c_path" ]; then
      configure_options="$configure_options --with-icu-dir=$icu4c_path"
    fi

    if [ -n "$jpeg_path" ]; then
      configure_options="$configure_options --with-jpeg-dir=$jpeg_path"
    fi

    if [ -n "$webp_path" ]; then
      configure_options="$configure_options --with-webp-dir=$webp_path"
    fi

    if [ -n "$libpng_path" ]; then
      configure_options="$configure_options --with-png-dir=$libpng_path"
    fi

    if [ -n "$openssl_path" ]; then
      configure_options="$configure_options --with-openssl=$openssl_path"
    fi

    if [ -n "$libxml2_path" ]; then
      configure_options="$configure_options --with-libxml-dir=$libxml2_path"
    fi

    if [ -n "$libxslt_path" ]; then
      configure_options="$configure_options --with-xsl=$libxslt_path"
    fi

    if [ -n "$zlib_path" ]; then
      configure_options="$configure_options --with-zlib-dir=$zlib_path"
    fi

    if [ -n "$libzip_path" ]; then
      configure_options="$configure_options --with-libzip=$libzip_path"
    fi

    if [ -n "$readline_path" ]; then
      configure_options="$configure_options --with-readline=$readline_path"
    fi

    if [ -n "$libedit_path" ]; then
      configure_options="$configure_options --with-libedit=$libedit_path"
    fi

    if [ -n "$bzip2_path" ]; then
      configure_options="$configure_options --with-bz2=$bzip2_path"
    fi

    if [ -n "$iconv_path" ]; then
      configure_options="$configure_options --with-iconv=$iconv_path"
    fi
  else
    # PHP's gd is built against the system libgd (--with-external-gd, a global
    # option), which brings its own JPEG and PNG support.
    configure_options="--with-openssl --with-curl --with-zlib --with-readline --with-gettext --with-xsl"

    if have_system_library libgmp.so gmp.h; then
      configure_options="$configure_options --with-gmp"
    else
      echo "gmp not found, not including in installation" >&2
    fi

    if have_system_library libsodium.so sodium.h; then
      configure_options="$configure_options --with-sodium"
    else
      echo "sodium not found, not including in installation" >&2
    fi
  fi

  echo "$configure_options"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [ "${1:-}" = "--remove-build" ]; then
    remove_build "$2"
    exit
  fi
  PHP_VERSION=${2:-$(sed -n 's/^#define PHP_VERSION "\([^"]*\)"/\1/p' "$1/main/php_version.h")}
  install_php "$1"
  install_composer "$1"
  # Both steps are done. Until now a failure in either removes the build of an
  # install path with a space, because vfox cannot reach it.
  trap - EXIT
fi
